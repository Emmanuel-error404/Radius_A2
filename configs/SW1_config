enable
configure terminal
!
hostname SW1
no ip domain-lookup
service password-encryption
!
enable secret Cisco1234
username admin privilege 15 secret Cisco1234
!
banner motd ^ACCESO SOLO AUTORIZADO - Toda actividad es registrada^
!
vlan 10
 name MGMT
exit
!
interface GigabitEthernet0/0
 description HACIA_R1_Fa0/0
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
exit
!
interface GigabitEthernet0/1
 description HACIA_DC01_10.7.98.10
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
exit
!
interface GigabitEthernet0/2
 description HACIA_PC_ADMIN_KALI_10.7.98.50
 switchport mode access
 switchport access vlan 10
 spanning-tree portfast
 no shutdown
exit
!
interface Vlan10
 description SVI_GESTION_MGMT
 ip address 10.7.98.2 255.255.255.0
 no shutdown
exit
!
ip default-gateway 10.7.98.1
!
ip access-list standard SSH_ACL
 permit 10.7.98.0 0.0.0.255
 deny any log
exit
!
ip domain-name redlab.local
crypto key generate rsa general-keys modulus 2048
ip ssh version 2
ip ssh time-out 60
ip ssh authentication-retries 3
!
! AAA DEBE habilitarse antes de la configuracion RADIUS/AAA.
aaa new-model
aaa authorization console
!
! Sintaxis RADIUS moderna validada para vIOS-L2 15.2(20200924).
radius-server key Cisco1234
radius server NPS
 address ipv4 10.7.98.10 auth-port 1812 acct-port 1813
 key Cisco1234
exit
!
aaa group server radius NPS-GRP
 server name NPS
exit
!
ip radius source-interface Vlan10
!
! Consola/AUX = RADIUS; VTY/SSH = usuario local.
aaa authentication login CON_AUX group NPS-GRP local
aaa authorization exec CON_AUX group NPS-GRP local
aaa authentication login default local
aaa authorization exec default local
!
aaa accounting exec default start-stop group NPS-GRP
aaa accounting system default start-stop group NPS-GRP
aaa accounting network default start-stop group NPS-GRP
aaa session-id common
!
! RBAC local - nivel 5.
privilege exec level 5 show privilege
privilege exec level 5 show version
privilege exec level 5 show clock
privilege exec level 5 show ip interface brief
privilege exec level 5 show vlan brief
!
! RBAC local - nivel 10.
privilege exec level 10 show running-config
privilege exec level 10 show configuration
privilege exec level 10 show logging
privilege exec level 10 ping
privilege exec level 10 configure terminal
privilege configure level 10 interface
privilege interface level 10 description
privilege interface level 10 ip address
!
logging buffered 64000 informational
login on-failure log
login on-success log
security authentication failure rate 3 log
!
line console 0
 exec-timeout 10 0
 logging synchronous
 login authentication CON_AUX
 authorization exec CON_AUX
exit
!
line aux 0
 exec-timeout 10 0
 login authentication CON_AUX
 authorization exec CON_AUX
exit
!
line vty 0 4
 exec-timeout 10 0
 login authentication default
 authorization exec default
 transport input ssh
 access-class SSH_ACL in
exit
!
end
! Verificar antes de guardar; luego: copy running-config startup-config
